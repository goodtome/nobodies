DB_URL=jdbc:mysql://localhost:3306/nobodies?useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC&characterEncoding=utf8
DB_USERNAME=root
DB_PASSWORD=123456

JWT_SECRET=replace_with_a_long_secure_secret_key_32_chars_minimum
JWT_EXPIRATION_SECONDS=7200

OSS_ENDPOINT=https://oss-cn-hangzhou.aliyuncs.com
OSS_ACCESS_KEY_ID=your_access_key_id
OSS_ACCESS_KEY_SECRET=your_access_key_secret
OSS_BUCKET=your_bucket_name
OSS_PRESIGN_DURATION_MINUTES=30

AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10
AUTH_PASSWORD_RESET_TOKEN_EXPIRATION_MINUTES=30

UPLOAD_MAX_FILE_SIZE=1099511627776
UPLOAD_ALLOWED_TYPES=mp4,mov,avi,mkv
UPLOAD_CHUNK_RETRY_TIMES=3

APP_CORS_ALLOWED_ORIGINS=http://localhost:5173
APP_FRONTEND_RESET_PASSWORD_URL=http://localhost:5173/reset-password
APP_MAIL_FROM=noreply@example.com

MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=your_smtp_username
MAIL_PASSWORD=your_smtp_password
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS_ENABLE=true
